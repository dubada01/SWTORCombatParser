<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <OrbsOutputDirectory Condition="'$(OrbsOutputDirectory)' == ''">../../bin/$(Configuration)/net8.0</OrbsOutputDirectory>
  </PropertyGroup>
  <ItemGroup>
    <!-- Match the production UI packages. Run-Profile.ps1 builds Orbs first. -->
    <PackageReference Include="Avalonia" Version="11.3.1" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.0" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="11.3.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.0" />
    <PackageReference Include="Avalonia.ReactiveUI" Version="11.3.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="9.0.3" />
    <Reference Include="Orbs">
      <HintPath>$(OrbsOutputDirectory)/Orbs.dll</HintPath>
    </Reference>
    <None Update="converter-resources.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyOrbsRuntime" AfterTargets="Build">
    <ItemGroup>
      <OrbsRuntime Include="$(OrbsOutputDirectory)/*.dll" />
      <OrbsResources Include="$(OrbsOutputDirectory)/DataStructures/**/*">
        <TargetRoot>DataStructures/</TargetRoot>
      </OrbsResources>
      <OrbsResources Include="$(OrbsOutputDirectory)/resources/**/*">
        <TargetRoot>resources/</TargetRoot>
      </OrbsResources>
      <OrbsResources Include="$(OrbsOutputDirectory)/runtimes/**/*">
        <TargetRoot>runtimes/</TargetRoot>
      </OrbsResources>
      <OrbsResources Include="$(OrbsOutputDirectory)/libvlc/**/*">
        <TargetRoot>libvlc/</TargetRoot>
      </OrbsResources>
    </ItemGroup>
    <Copy SourceFiles="@(OrbsRuntime)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(OrbsResources)"
          DestinationFiles="@(OrbsResources->'$(OutputPath)%(TargetRoot)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
