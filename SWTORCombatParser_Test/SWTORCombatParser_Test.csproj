<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows7.0</TargetFramework>

    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="PlatformHarness\**" />
    <EmbeddedResource Remove="PlatformHarness\**" />
    <None Remove="PlatformHarness\**" />
    <None Remove="keetsuneTimers.json" />
    <!-- The full UI profiler is a separate executable, not part of NUnit. -->
    <Compile Remove="FullLoadProfile\**" />
    <EmbeddedResource Remove="FullLoadProfile\**" />
    <None Remove="FullLoadProfile\**" />
    <AvaloniaXaml Remove="FullLoadProfile\**" />
    <AvaloniaResource Remove="FullLoadProfile\**" />
    <AdditionalFiles Remove="FullLoadProfile\**" />
    <!-- The raid-frame UI harness also runs as a separate executable. -->
    <Compile Remove="RaidFrameHarness\**" />
    <EmbeddedResource Remove="RaidFrameHarness\**" />
    <None Remove="RaidFrameHarness\**" />
    <AvaloniaXaml Remove="RaidFrameHarness\**" />
    <AvaloniaResource Remove="RaidFrameHarness\**" />
    <AdditionalFiles Remove="RaidFrameHarness\**" />
    <!-- Configuration visual checks run in their own isolated desktop process. -->
    <Compile Remove="ConfigurationHarness\**" />
    <EmbeddedResource Remove="ConfigurationHarness\**" />
    <None Remove="ConfigurationHarness\**" />
    <AvaloniaXaml Remove="ConfigurationHarness\**" />
    <AvaloniaResource Remove="ConfigurationHarness\**" />
    <AdditionalFiles Remove="ConfigurationHarness\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="keetsuneTimers.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SWTORCombatParser.csproj" />
  </ItemGroup>

</Project>
