<UserControl x:Class="SWTORCombatParser.Views.Overlay.UtilityOverlayOptionView"
             xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SWTORCombatParser.ViewModels.Overlays" x:DataType="vm:UtilityOverlayOptionViewModel">
    <Button Classes="RoundedCorner OverlayChoice" Classes.selected="{Binding IsSelected}" CommandParameter="{Binding .}"
            IsEnabled="{Binding Enabled}" Command="{Binding $parent[ItemsControl].((vm:OverlayViewModel)DataContext).ToggleUtilityCommand}"
            ToolTip.Tip="{Binding HelpText}">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock Grid.Column="1" Text="✓" IsVisible="{Binding IsSelected}" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </Grid>
    </Button>
</UserControl>
