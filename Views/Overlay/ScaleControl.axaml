<UserControl x:Class="SWTORCombatParser.Views.Overlay.ScaleControl"
             xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SWTORCombatParser.ViewModels.Overlays.BossFrame" x:DataType="vm:BossFrameConfigViewModel"
             Width="100" Height="24">
    <Border Background="#202E29" CornerRadius="3">
        <Grid ColumnDefinitions="24,*,24">
            <Button x:Name="DecreaseScale" Content="−" Command="{Binding DecreaseCommand}" ToolTip.Tip="Smaller boss frame"
                    Classes="RoundedCorner" Background="Transparent" FontSize="15" Padding="0" MinHeight="0" Height="24" HorizontalContentAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding CurrentScale, StringFormat='{}{0:0.0}×'}" FontSize="11" Foreground="#DCE7E0"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Button x:Name="IncreaseScale" Grid.Column="2" Content="+" Command="{Binding IncreaseCommand}" ToolTip.Tip="Larger boss frame"
                    Classes="RoundedCorner" Background="Transparent" FontSize="15" Padding="0" MinHeight="0" Height="24" HorizontalContentAlignment="Center"/>
        </Grid>
    </Border>
</UserControl>
