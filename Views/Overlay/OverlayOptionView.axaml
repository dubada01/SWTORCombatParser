<UserControl x:Class="SWTORCombatParser.Views.Overlay.OverlayOptionView"
             xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SWTORCombatParser.ViewModels.Overlays" x:DataType="vm:OverlayOptionViewModel">
    <Grid ColumnDefinitions="*,30">
        <Button x:Name="MetricToggle" Classes="RoundedCorner OverlayChoice" Classes.selected="{Binding IsSelected}" CommandParameter="{Binding .}"
                Command="{Binding $parent[ItemsControl].((vm:OverlayViewModel)DataContext).GenerateOverlay}"
                ToolTip.Tip="{Binding HelpText}" PointerReleased="Button_PreviewMouseRightButtonUp" Margin="0,0,4,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Type, Converter={StaticResource OverlayTypeToReadableNameConverter}}"
                           FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="✓" IsVisible="{Binding IsSelected}" Margin="3,0,0,0" VerticalAlignment="Center"/>
            </Grid>
        </Button>
        <Button x:Name="ColorButton" Grid.Column="1" Click="ChangeColor" Classes="RoundedCorner" Padding="5" MinHeight="36"
                Background="{StaticResource Gray3Brush}" BorderBrush="{StaticResource Gray5Brush}" BorderThickness="1" CornerRadius="4"
                ToolTip.Tip="{Binding ColorButtonLabel}" AutomationProperties.Name="{Binding ColorButtonLabel}">
            <Border Width="17" Height="17" CornerRadius="3" Background="{Binding Type, Converter={StaticResource OverlayMetricTypeToColorConverter}}"/>
        </Button>
    </Grid>
</UserControl>
