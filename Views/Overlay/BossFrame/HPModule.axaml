<UserControl x:Class="SWTORCombatParser.Views.Overlay.BossFrame.HPModule"
             xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SWTORCombatParser.ViewModels.Overlays.BossFrame" x:DataType="vm:HPModuleViewModel">
    <Border Classes="OverlayCard">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto">
            <TextBlock Classes="BossLabel" Text="{Binding BossName}" FontSize="{Binding NameFontSize}" FontWeight="SemiBold"
                       FontFamily="{StaticResource MainFont}" Foreground="#EFF4F0" TextTrimming="CharacterEllipsis" Margin="0,0,0,5"/>
            <Border Grid.Row="1" Height="{Binding Height}" Background="{DynamicResource OverlaySurfaceBrush}" CornerRadius="2" ClipToBounds="True">
                <Grid ColumnDefinitions="*,Auto">
                    <Grid Grid.ColumnSpan="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding BarWidth}"/><ColumnDefinition Width="{Binding RemainderWidth}"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#984A4A" Opacity="0.85"/>
                    </Grid>
                    <TextBlock Classes="OverlayCompactOnly" Text="{Binding CompactHealth}" Foreground="#D9E0DC" FontSize="{Binding TargetFontSize}"
                               FontFamily="{StaticResource MainFont}" VerticalAlignment="Center" Margin="7,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding HPPercentText}" Foreground="#FFFFFF" FontSize="{Binding HealthFontSize}"
                               FontFamily="{StaticResource MainFont}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="7,0"/>
                </Grid>
            </Border>
            <TextBlock Grid.Row="2" Classes="OverlayDetail" Text="{Binding DetailedHealth}" Foreground="#A3B8AF"
                       FontFamily="{StaticResource MainFont}" FontSize="{Binding TargetFontSize}" Margin="0,5,0,0"/>
            <Grid Grid.Row="3" ColumnDefinitions="Auto,*" IsVisible="{Binding CurrentTargetIndicatorVisible}" Margin="0,5,0,0">
                <TextBlock Text="TARGET" Classes="OverlayLabel" FontSize="{Binding TargetFontSize}" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" Text="{Binding BossTargetText}" FontFamily="{StaticResource MainFont}"
                           FontSize="{Binding TargetFontSize}" Foreground="#E3C58D" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
