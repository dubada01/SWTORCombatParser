<UserControl x:Class="SWTORCombatParser.Views.Overlay.BossFrame.BrossFrameView"
             xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:overlay="clr-namespace:SWTORCombatParser.Views.Overlay"
             xmlns:vm="clr-namespace:SWTORCombatParser.ViewModels.Overlays.BossFrame" x:DataType="vm:BossFrameConfigViewModel">
    <Grid x:Name="MainArea" RowDefinitions="Auto,Auto" IsVisible="{Binding ShowFrame}">
        <Grid ColumnDefinitions="*,Auto" Margin="3,2,3,5" Background="{DynamicResource OverlaySurfaceBrush}">
            <StackPanel IsVisible="{Binding CombatDurationVisible}" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="ENCOUNTER" Classes="OverlayLabel"/>
                <TextBlock Text="{Binding CombatDuration}" FontSize="12" Foreground="#DCE7E0" FontFamily="{StaticResource MainFont}"/>
            </StackPanel>
            <overlay:ScaleControl Grid.Column="1" IsVisible="{Binding OverlaysMoveable}" Opacity="0.7"/>
        </Grid>
        <ItemsControl Grid.Row="1" ItemsSource="{Binding BossesDetected}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,7" RowDefinitions="Auto,Auto,Auto">
                        <ContentPresenter Content="{Binding HPContent}"/>
                        <ContentPresenter Grid.Row="1" Content="{Binding DOTSContent}" Margin="4,0"/>
                        <ContentPresenter Classes="EncounterTimers" Grid.Row="2" Content="{Binding MechanicsModule}"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
