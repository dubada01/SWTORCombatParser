<UserControl x:Class="SWTORCombatParser.Views.Overlay.BossFrame.RaidDotInstance"
             xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SWTORCombatParser.ViewModels.Timers" x:DataType="vm:TimerInstanceViewModel">
    <Border Classes="TimerTrack" Margin="0,2">
        <Grid ColumnDefinitions="Auto,*,Auto">
            <Border x:Name="TimerBar" Grid.ColumnSpan="3" Background="{Binding TimerForeground}" Opacity="0.35" RenderTransformOrigin="1,0">
                <Border.RenderTransform><ScaleTransform ScaleX="{Binding CurrentRatio, Mode=OneTime}" ScaleY="1"/></Border.RenderTransform>
            </Border>
            <Image IsVisible="{Binding ShowIcon}" Source="{Binding InfoIcon}" MaxWidth="{Binding IconSize}"
                   MaxHeight="{Binding IconSize}" Margin="3,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Classes="TimerLabel" Text="{Binding TimerName}" FontSize="{Binding LabelFontSize}"
                       FontFamily="{StaticResource MainFont}" Foreground="#DCE7E0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="7,0"/>
            <TextBlock Grid.Column="2" Text="{Binding TimerValue, StringFormat=N1}" IsVisible="{Binding DisplayTimerValue}"
                       FontSize="{Binding LabelFontSize}" FontFamily="{StaticResource MainFont}" Foreground="{Binding TimerBackground}"
                       VerticalAlignment="Center" Margin="7,0"/>
        </Grid>
    </Border>
</UserControl>
