<UserControl x:Class="SWTORCombatParser.Views.Overlay.CombatMetricsConfigView"
             xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SWTORCombatParser.Views.Overlay"
             xmlns:vm="clr-namespace:SWTORCombatParser.ViewModels.Overlays" x:DataType="vm:OverlayViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid ColumnDefinitions="*,*,*,*">
            <StackPanel Grid.Column="0" Margin="0,0,6,0" Spacing="6">
                <TextBlock Text="Damage" Classes="SectionHeading"/>
                <ItemsControl ItemsSource="{Binding MainDamageOverlays}">
                    <ItemsControl.ItemTemplate><DataTemplate><local:OverlayOptionView Margin="0,0,0,6"/></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Advanced" FontSize="11" Foreground="{StaticResource Gray11Brush}" Margin="0,12,0,2"/>
                <ItemsControl ItemsSource="{Binding AdvancedDamageOverlays}">
                    <ItemsControl.ItemTemplate><DataTemplate><local:OverlayOptionView Margin="0,0,0,6"/></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="6,0,6,0" Spacing="6">
                <TextBlock Text="Healing" Classes="SectionHeading"/>
                <ItemsControl ItemsSource="{Binding MainHealOverlays}">
                    <ItemsControl.ItemTemplate><DataTemplate><local:OverlayOptionView Margin="0,0,0,6"/></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Advanced" FontSize="11" Foreground="{StaticResource Gray11Brush}" Margin="0,12,0,2"/>
                <ItemsControl ItemsSource="{Binding AdvancedHealOverlays}">
                    <ItemsControl.ItemTemplate><DataTemplate><local:OverlayOptionView Margin="0,0,0,6"/></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="6,0,6,0" Spacing="6">
                <TextBlock Text="Mitigation" Classes="SectionHeading"/>
                <ItemsControl ItemsSource="{Binding MainMitigationOverlays}">
                    <ItemsControl.ItemTemplate><DataTemplate><local:OverlayOptionView Margin="0,0,0,6"/></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Advanced" FontSize="11" Foreground="{StaticResource Gray11Brush}" Margin="0,12,0,2"/>
                <ItemsControl ItemsSource="{Binding AdvancedMitigationOverlays}">
                    <ItemsControl.ItemTemplate><DataTemplate><local:OverlayOptionView Margin="0,0,0,6"/></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <StackPanel Grid.Column="3" Margin="6,0,0,0" Spacing="6">
                <TextBlock Text="General" Classes="SectionHeading"/>
                <ItemsControl ItemsSource="{Binding AvailableGeneralOverlays}">
                    <ItemsControl.ItemTemplate><DataTemplate><local:OverlayOptionView Margin="0,0,0,6"/></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
