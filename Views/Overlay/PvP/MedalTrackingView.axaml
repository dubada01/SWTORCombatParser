<UserControl x:Class="SWTORCombatParser.Views.Overlay.PvP.MedalTrackingView"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SWTORCombatParser.Views.Overlay.PvP"
        xmlns:vm="clr-namespace:SWTORCombatParser.ViewModels.Overlays.PvP"
        x:DataType="vm:MedalTrackingViewModel"
        mc:Ignorable="d"
        Background="{x:Null}">
    <Grid x:Name="MainArea" IsVisible="{Binding ShowFrame, Converter={StaticResource BooleanToHiddenVisibilityConverter}}" ToolTip.Tip="PvP Medal Tracker">
        <ItemsControl ItemsSource="{Binding AvailablePvPMedals}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <local:PvPMedalStatus/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
