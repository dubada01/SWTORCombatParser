<UserControl x:Class="SWTORCombatParser.Views.Home_Views.EffectsView"
 xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="clr-namespace:SWTORCombatParser.ViewModels.CombatMetaData" x:DataType="vm:CombatEfffectViewModel">
 <Grid RowDefinitions="Auto,*,Auto" Margin="9,0,9,9" RowSpacing="8">
  <StackPanel Spacing="6">
   <ComboBox x:Name="EffectDirection" ItemsSource="{Binding AvailableEffectTypes}" SelectedItem="{Binding SelectedEffectType}" FontSize="12" HorizontalAlignment="Stretch" MinHeight="30"
    ToolTip.Tip="Self is the participant selected above the graph. Choose whose effects to inspect."/>
   <ComboBox x:Name="EffectOther" ItemsSource="{Binding AvailableOthers}" SelectedItem="{Binding SelectedOther}" IsVisible="{Binding OtherSelectionVisible}" FontSize="12" HorizontalAlignment="Stretch" MinHeight="30" ToolTip.Tip="Limit the other source or target."/>
  </StackPanel>
  <ListBox x:Name="EffectList" Grid.Row="1" ItemsSource="{Binding CombatEffects}" SelectedItem="{Binding SelectedEffect}" SelectionMode="Single" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
   <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="Padding" Value="4,5"/><Setter Property="MinHeight" Value="28"/></Style></ListBox.Styles>
   <ListBox.ItemTemplate><DataTemplate x:DataType="vm:EffectViewModel">
    <Grid ColumnDefinitions="8,*,Auto" ColumnSpacing="5" ToolTip.Tip="{Binding Name}">
     <Ellipse Width="5" Height="5" Fill="{StaticResource GreenColorBrush}" IsVisible="{Binding Selected}"/>
     <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="11" VerticalAlignment="Center"/>
     <TextBlock Grid.Column="2" Text="{Binding Duration, StringFormat='{}{0:0.#}s'}" FontSize="11" Foreground="{StaticResource Gray12Brush}" VerticalAlignment="Center"/>
    </Grid>
   </DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <Button x:Name="ClearEffects" Grid.Row="2" Classes="AnalysisAction" Content="Clear highlight" Command="{Binding ClearCombatEffectsCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Clear highlighted effect intervals on the graph."/>
 </Grid>
</UserControl>
