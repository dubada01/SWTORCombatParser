<UserControl x:Class="SWTORCombatParser.Views.Home_Views.ParticipantInstanceView"
 xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="clr-namespace:SWTORCombatParser.ViewModels.Home_View_Models" x:DataType="vm:ParticipantViewModel">
 <Button Click="SelectParticipant" Margin="2" Padding="8,7" MinHeight="36" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
  Background="{Binding IsSelected, Converter={StaticResource ParticipantSelectedToBackgroundConverter}}"
  BorderBrush="{Binding IsSelected, Converter={StaticResource ParticipantSelectedToBoarderConverter}}" BorderThickness="1" CornerRadius="3" ToolTip.Tip="{Binding Summary}">
  <Grid ColumnDefinitions="16,*,Auto" ColumnSpacing="6">
   <Image Width="16" Height="16" Source="{Binding RoleImageSource}"/>
   <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Foreground="WhiteSmoke" Text="{Binding PlayerName}" TextTrimming="CharacterEllipsis"/>
   <Image Grid.Column="2" Width="12" Height="12" Source="avares://Orbs/resources/LocalPlayerIcon.png" IsVisible="{Binding IsLocalPlayer}"/>
  </Grid>
 </Button>
</UserControl>
