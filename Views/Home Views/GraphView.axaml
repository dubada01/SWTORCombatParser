<UserControl x:Class="SWTORCombatParser.Views.Home_Views.GraphView" Classes="AnalysisPage"
 xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:plot="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia" xmlns:vm="clr-namespace:SWTORCombatParser.ViewModels.Home_View_Models" x:DataType="vm:PlotViewModel">
 <UserControl.Styles><StyleInclude Source="avares://Orbs/Utilities/UIStyles/Analysis.axaml"/></UserControl.Styles>
 <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="12,10" RowSpacing="8">
  <ContentPresenter Content="{Binding ParticipantSelectionContent}" MaxHeight="120"/>
  <Grid Grid.Row="1" ColumnDefinitions="Auto,54,Auto,Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
   <TextBlock Classes="AnalysisLabel" Text="Average"/>
   <NumericUpDown x:Name="Smoothing" Grid.Column="1" Minimum="1" Maximum="120" Increment="1" FormatString="0" Value="{Binding AverageWindowSeconds}" Height="32" FontSize="12" ShowButtonSpinner="False" Padding="8,4" ToolTip.Tip="Rolling-average window in seconds. Type a value or use the up/down keys."/>
   <TextBlock Grid.Column="2" Classes="AnalysisLabel" Text="s"/>
   <Button x:Name="FitPlot" Grid.Column="3" Classes="AnalysisAction" Content="Fit view" Command="{Binding FitViewCommand}" ToolTip.Tip="Show the full combat and resume following live updates."/>
   <CheckBox x:Name="ShowPoints" Grid.Column="4" Content="Points" IsChecked="{Binding ShowPoints}" FontSize="12" ToolTip.Tip="Show individual combat events. Hover a point for its ability and amount."/>
   <CheckBox x:Name="ShowTrends" Grid.Column="5" Content="Trends" IsChecked="{Binding ShowTrends}" FontSize="12" ToolTip.Tip="Show rolling-average rate lines and the selected health trace."/>
   <CheckBox x:Name="ShowBosses" Grid.Column="7" Content="Bosses" IsChecked="{Binding ViewBosses}" FontSize="12" ToolTip.Tip="Include bosses in the participant picker."/>
   <CheckBox Grid.Column="8" Content="Follow live" IsChecked="{Binding FollowLive}" FontSize="12" ToolTip.Tip="Turn off to keep your zoom and pan position during live updates."/>
  </Grid>
  <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
   <Border BorderBrush="{StaticResource Gray4Brush}" BorderThickness="1">
    <Grid><plot:AvaPlot Name="GridView" PointerMoved="GridView_MouseMove"/>
     <TextBlock Text="Enable points or trends to show combat data" IsVisible="{Binding NoDisplayLayers}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Gray12Brush}" IsHitTestVisible="False"/>
    </Grid>
   </Border>
   <Grid Grid.Column="1">
    <Border IsVisible="{Binding ShowEffects}" Width="225" BorderBrush="{StaticResource Gray4Brush}" BorderThickness="1" Background="{StaticResource Gray1Brush}">
     <Grid RowDefinitions="Auto,*">
      <Button x:Name="CollapseEffects" Command="{Binding ToggleEffectsCommand}" Background="Transparent" BorderThickness="0" Padding="9,5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" ToolTip.Tip="Collapse effects tray">
       <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Effects" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="›" FontSize="20"/></Grid>
      </Button>
      <ContentPresenter Grid.Row="1" Content="{Binding EffectsView}"/>
     </Grid>
    </Border>
    <Button x:Name="ExpandEffects" Classes="AnalysisAction" IsVisible="{Binding !ShowEffects}" Command="{Binding ToggleEffectsCommand}" Width="28" MinWidth="0" Padding="0,7" VerticalAlignment="Stretch" VerticalContentAlignment="Top" HorizontalContentAlignment="Center" ToolTip.Tip="Expand effects tray">
     <StackPanel Spacing="8"><TextBlock Text="‹" FontSize="20" HorizontalAlignment="Center"/>
      <LayoutTransformControl><LayoutTransformControl.LayoutTransform><RotateTransform Angle="-90"/></LayoutTransformControl.LayoutTransform><TextBlock Text="Effects" FontSize="12"/></LayoutTransformControl>
     </StackPanel>
    </Button>
   </Grid>
  </Grid>
  <ItemsControl Grid.Row="3" ItemsSource="{Binding LegendItems}">
   <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
   <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:LegendItemViewModel">
    <Border BorderBrush="{StaticResource Gray4Brush}" BorderThickness="1" Background="{StaticResource Gray1Brush}" CornerRadius="3" Padding="8,2" Margin="0,0,6,0" MinWidth="88">
     <StackPanel>
      <CheckBox Content="{Binding Name}" Foreground="{Binding LegendColor}" IsChecked="{Binding Checked}" FontSize="12" MinHeight="23" ToolTip.Tip="Show effective values and rate"/>
      <CheckBox Content="Raw" IsVisible="{Binding ShowEffective}" IsChecked="{Binding EffectiveChecked}" FontSize="11" MinHeight="23" ToolTip.Tip="Show raw values before overheal or overkill is removed"/>
     </StackPanel>
    </Border>
   </DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
 </Grid>
</UserControl>
