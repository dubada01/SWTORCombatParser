<UserControl x:Class="SWTORCombatParser.Views.Home_Views.ParticipantSelectionView"
 xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:SWTORCombatParser.Views.Home_Views" xmlns:vm="clr-namespace:SWTORCombatParser.ViewModels.Home_View_Models" x:DataType="vm:ParticipantSelectionViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <ItemsControl ItemsSource="{Binding AvailableParticipants}">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="{Binding Rows}" Columns="{Binding Columns}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate><DataTemplate><local:ParticipantInstanceView/></DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
  </ScrollViewer>
</UserControl>
