<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:timers="clr-namespace:SWTORCombatParser.ViewModels.Timers"
             x:DataType="timers:ModifyTimerViewModel"
             x:Class="SWTORCombatParser.Views.Timers.VariablesTabContent">
    <StackPanel Spacing="12">
        <StackPanel Spacing="5">
            <TextBlock Classes="FieldLabel" Text="Variable"/>
            <ComboBox ItemsSource="{Binding AvailableVariables}" SelectedItem="{Binding SelectedModifyVariable}" HorizontalAlignment="Stretch"/>
            <Grid ColumnDefinitions="*,Auto">
                <TextBox Text="{Binding AddedVariable}" ToolTip.Tip="New variable name"/>
                <Button Grid.Column="1" Classes="RoundedCorner DialogAction" Content="Add" Command="{Binding AddCustomVariableCommand}" Margin="8,0,0,0"/>
            </Grid>
        </StackPanel>
        <StackPanel Spacing="5">
            <TextBlock Classes="FieldLabel" Text="Action"/>
            <ComboBox ItemsSource="{Binding AvailableActions}" SelectedItem="{Binding SelectedAction}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDisplayNameConverter}, Mode=OneWay}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
        </StackPanel>
        <StackPanel Spacing="5">
            <TextBlock Classes="FieldLabel" Text="Value"/>
            <TextBox Text="{Binding VariableModificationValue}"/>
        </StackPanel>
        <CheckBox Content="Also show timer" IsChecked="{Binding IncludeTimerVisuals}" ToolTip.Tip="Display the timer as well as changing the variable."/>
    </StackPanel>
</UserControl>
