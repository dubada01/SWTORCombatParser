<UserControl x:Class="SWTORCombatParser.Views.Timers.TimerInstanceView"
             xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SWTORCombatParser.ViewModels.Timers" x:DataType="vm:TimerInstanceViewModel">
    <Border Classes="TimerTrack" Margin="0,2" IsVisible="{Binding DisplayTimer}">
        <Grid ColumnDefinitions="3,Auto,*,Auto">
            <Border Grid.ColumnSpan="4" IsVisible="{Binding SourceTimer.TriggerType, Converter={StaticResource AbsorbTimerBarVisibilityConverter}, ConverterParameter=inverted}">
                <Border x:Name="TimerBar" Background="{Binding TimerForeground}" Opacity="0.42" RenderTransformOrigin="1,0">
                    <Border.RenderTransform><ScaleTransform ScaleX="{Binding CurrentRatio}" ScaleY="1"/></Border.RenderTransform>
                </Border>
            </Border>
            <Border x:Name="AbsorbBar" Grid.ColumnSpan="4" Background="{Binding TimerForeground}" Opacity="0.42"
                    IsVisible="{Binding SourceTimer.TriggerType, Converter={StaticResource AbsorbTimerBarVisibilityConverter}}" RenderTransformOrigin="1,0">
                <Border.RenderTransform><ScaleTransform ScaleX="{Binding CurrentRatio}" ScaleY="1"/></Border.RenderTransform>
            </Border>
            <Border Classes="TimerAccent"/>
            <Image Grid.Column="1" Margin="4,0,0,0" MaxWidth="{Binding IconSize}" MaxHeight="{Binding IconSize}"
                   VerticalAlignment="Center" Source="{Binding InfoIcon}"/>
            <TextBlock x:Name="NameText" Classes="TimerLabel" Grid.Column="2" Margin="7,0,6,0" VerticalAlignment="Center"
                       FontFamily="{StaticResource MainFont}" FontSize="{Binding LabelFontSize}" Foreground="#EFF4F0"
                       TextTrimming="CharacterEllipsis" Text="{Binding OverlayTimerLabel}" ToolTip.Tip="{Binding TimerName}"/>
            <Border Grid.Column="3" Background="#68101815" MinWidth="54" Padding="7,0" IsVisible="{Binding ShowOverlayTimerValue}">
                <TextBlock x:Name="ValueText" FontSize="{Binding ValueFontSize}" FontWeight="SemiBold"
                           FontFamily="{StaticResource MainFont}" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{Binding TimerBackground}" Text="{Binding OverlayTimerValue}"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
