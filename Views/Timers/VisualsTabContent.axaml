<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:timers="clr-namespace:SWTORCombatParser.ViewModels.Timers"
             x:DataType="timers:ModifyTimerViewModel"
             x:Class="SWTORCombatParser.Views.Timers.VisualsTabContent">
    <StackPanel Spacing="12">
        <StackPanel Spacing="8" IsVisible="{Binding ShowDurationOrAlert}">
            <CheckBox Content="Show as alert" IsChecked="{Binding IsAlert}" ToolTip.Tip="Display alert text instead of a countdown bar."/>
            <StackPanel Spacing="5" IsVisible="{Binding ShowDuration}">
                <TextBlock Classes="FieldLabel" Text="Duration (seconds)"/>
                <TextBox Text="{Binding DurationSec}"/>
            </StackPanel>
            <StackPanel Spacing="5" IsVisible="{Binding ShowDuration, Converter={StaticResource BooleanToInverseConverter}}">
                <TextBlock Classes="FieldLabel" Text="Alert text"/>
                <TextBox Text="{Binding AlertText}"/>
            </StackPanel>
        </StackPanel>
        <CheckBox Content="Show target name" IsChecked="{Binding ShowTargetOnTimerUI}" IsVisible="{Binding DisplayTargetToggle}"/>
        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowColor}">
            <TextBlock Classes="FieldLabel" Text="Color" VerticalAlignment="Center"/>
            <ColorPicker Grid.Column="1" Height="32" Width="110" Color="{Binding SelectedColor, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
        </Grid>
        <Border Classes="SectionDivider" IsVisible="{Binding ShowDurationOrAlert}"/>
        <StackPanel Spacing="8" IsVisible="{Binding ShowDurationOrAlert}">
            <CheckBox Content="Play audio" IsChecked="{Binding UseAudio}"/>
            <StackPanel Spacing="8" IsVisible="{Binding UseAudio}">
                <Grid ColumnDefinitions="*,Auto">
                    <ComboBox ItemsSource="{Binding AudioTypes}" SelectedItem="{Binding SelectedAudioType}" HorizontalAlignment="Stretch" ToolTip.Tip="{Binding SelectedAudioType}"/>
                    <Button Grid.Column="1" Classes="RoundedCorner DialogAction" Command="{Binding LoadAudioCommand}" Content="Browse…" Margin="8,0,0,0"/>
                </Grid>
                <Grid ColumnDefinitions="*,80">
                    <TextBlock Classes="FieldLabel" Text="Play with seconds remaining" VerticalAlignment="Center" Margin="0,0,8,0" TextWrapping="Wrap"/>
                    <TextBox Grid.Column="1" Text="{Binding CustomAudioPlayTime, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </StackPanel>
        </StackPanel>
        <StackPanel Spacing="5" IsVisible="{Binding ShowDurationOrAlert}">
            <TextBlock Classes="FieldLabel" Text="Show only in the last (seconds)"/>
            <TextBox Text="{Binding HideUntilTime, UpdateSourceTrigger=PropertyChanged}" Watermark="Full countdown"
                     ToolTip.Tip="Leave empty or use zero to show the full countdown. Set a threshold to hide a long timer until it matters."/>
        </StackPanel>
    </StackPanel>
</UserControl>
