<Window x:Class="SWTORCombatParser.Views.Timers.TimerSharePopup"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Classes="OrbsDialog" Title="Share timer" Width="380" Height="220" CanResize="False"
        WindowStartupLocation="CenterOwner" Topmost="True">
    <Grid Margin="20,16" RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock Classes="FieldLabel" Text="Share code"/>
        <TextBox x:Name="ShareCode" Grid.Row="1" Margin="0,6,0,0" IsReadOnly="True"
                 HorizontalContentAlignment="Center" FontSize="20" FontWeight="DemiBold"
                 ToolTip.Tip="Use this code to import the timer in Orbs."/>
        <TextBlock x:Name="LoadingText" Grid.Row="2" Margin="0,8,0,8" FontSize="11" Foreground="LightGray"
                   TextWrapping="Wrap" Text="Use this code to import the timer."/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="CopyButton" Classes="RoundedCorner DialogAction" Content="Copy code"/>
            <Button x:Name="OkButton" Classes="RoundedCorner DialogAction PrimaryAction" Content="Done" MinWidth="80"/>
        </StackPanel>
    </Grid>
</Window>
