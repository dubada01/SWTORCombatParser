<Window x:Class="SWTORCombatParser.Views.Timers.TimersCreationView"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SWTORCombatParser.ViewModels.Timers"
        x:DataType="vm:TimersCreationViewModel"
        Classes="OrbsDialog" Title="Timers" Width="960" Height="620" MinWidth="820" MinHeight="460">
    <Grid Margin="20,12,20,16" RowDefinitions="Auto,Auto,*,Auto">
        <TabStrip ItemsSource="{Binding TimerSourcesTypes}" SelectedItem="{Binding SelectedTimerSourceType, Mode=TwoWay}"
                  HorizontalAlignment="Left" Margin="0,0,0,12"/>
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding DisciplineTimerSelected}">
                <TextBlock Classes="FieldLabel" Text="Discipline" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding DisciplineTimersList}" SelectedItem="{Binding SelectedDisciplineSource, Mode=TwoWay}" Width="280"/>
            </StackPanel>
            <ContentPresenter Content="{Binding EncounterSelectionView}"
                              IsVisible="{Binding DisciplineTimerSelected, Converter={StaticResource BooleanToInverseConverter}}"
                              HorizontalAlignment="Left"/>
        </Grid>
        <DataGrid Grid.Row="2" ItemsSource="{Binding TimerRows}" IsReadOnly="True" AutoGenerateColumns="False"
                  CanUserResizeColumns="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="36"
                  BorderThickness="1" BorderBrush="{StaticResource Gray5Brush}" Background="{StaticResource Gray2Brush}">
            <DataGrid.Styles>
                <!-- Fluent reserves 32 pixels for every sort icon, even when it is hidden. -->
                <Style Selector="DataGridColumnHeader /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Grid.ColumnSpan" Value="2"/>
                </Style>
                <Style Selector="DataGridColumnHeader:sortascending /template/ ContentPresenter#PART_ContentPresenter, DataGridColumnHeader:sortdescending /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Margin" Value="0,0,16,0"/>
                </Style>
                <Style Selector="DataGridColumnHeader /template/ Path#SortIcon">
                    <Setter Property="Width" Value="10"/>
                    <Setter Property="Margin" Value="6,0,0,0"/>
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                </Style>
            </DataGrid.Styles>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Width="*" MinWidth="140" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="Trigger" Width="130" Binding="{Binding Type, Converter={StaticResource EnumDisplayNameConverter}, Mode=OneWay}"/>
                <DataGridTextColumn Header="Seconds" Width="84" Binding="{Binding DurationSec, StringFormat='#,0.#'}"/>
                <DataGridTemplateColumn Header="Color" Width="64" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Background="{Binding TimerForeground}" Command="{Binding EditCommand}" Width="28" Height="18"
                                    MinHeight="0" Padding="0" BorderThickness="0" HorizontalAlignment="Center" ToolTip.Tip="Edit timer color"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Enabled" Width="76" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center" IsChecked="{Binding IsEnabled}" ToolTip.Tip="Enable this timer"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Visible" Width="72" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button HorizontalAlignment="Center" Command="{Binding ToggleVisibilityCommand}" Padding="5" ToolTip.Tip="Toggle timer visibility">
                                <Image Height="18" Width="18" Source="{Binding VisibilityImageSource}"/>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Audio" Width="68" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button BorderBrush="{Binding AudioButtonBorderColor}" HorizontalAlignment="Center" Command="{Binding ToggleAudioCommand}" Padding="5" ToolTip.Tip="Toggle timer audio">
                                <Image Height="18" Width="18" Source="{Binding AudioImageSource}"/>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Actions" Width="144" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Button Command="{Binding EditCommand}" Padding="5" ToolTip.Tip="Edit timer">
                                    <Image Height="18" Width="18" Source="avares://Orbs/resources/editIcon.png"/>
                                </Button>
                                <Button Command="{Binding CopyCommand}" Padding="5" ToolTip.Tip="Duplicate timer">
                                    <Image Height="18" Width="18" Source="avares://Orbs/resources/copyIcon.png"/>
                                </Button>
                                <Button Command="{Binding ShareCommand}" Padding="5" ToolTip.Tip="Share timer">
                                    <Image Height="18" Width="18" Source="avares://Orbs/resources/shareIcon.png"/>
                                </Button>
                                <Button Command="{Binding DeleteCommand}" Content="×" Classes="RoundedCorner" Width="28" Height="28" Padding="0"
                                        Foreground="{StaticResource RedColorBrush}" ToolTip.Tip="Delete timer"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Text="{Binding ImportId}" Watermark="Share code" Width="140" ToolTip.Tip="Enter a timer share code"/>
                <Button Classes="RoundedCorner DialogAction" Content="Import" Command="{Binding ImportCommand}"/>
            </StackPanel>
            <Button Grid.Column="2" Classes="RoundedCorner DialogAction PrimaryAction" Content="New timer" Command="{Binding CreateNewTimerCommand}"/>
        </Grid>
    </Grid>
</Window>
