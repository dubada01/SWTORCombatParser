<Window x:Class="SWTORCombatParser.Views.Timers.TimerModificationWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SWTORCombatParser.Views.Timers"
        xmlns:vm="clr-namespace:SWTORCombatParser.ViewModels.Timers"
        x:DataType="vm:ModifyTimerViewModel"
        Classes="OrbsDialog" Title="{Binding EditorTitle}" Width="820" Height="660" MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterOwner">
    <Window.Styles>
        <Style Selector="DataValidationErrors">
            <Setter Property="ErrorTemplate">
                <DataTemplate>
                    <TextBlock Text="Enter a valid number." TextWrapping="Wrap"/>
                </DataTemplate>
            </Setter>
        </Style>
    </Window.Styles>
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Classes="EditorHeader">
            <StackPanel Spacing="8">
                <TextBox x:Name="TimerName" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Watermark="Timer name"
                         ToolTip.Tip="Name shown on the timer overlay" IsVisible="{Binding IsSubTrigger, Converter={StaticResource BooleanToInverseConverter}}"/>
                <TextBlock Classes="SectionHeading" Text="Timer condition" Margin="0" IsVisible="{Binding IsSubTrigger}"/>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="EditorContext" Text="{Binding EditorScope}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding EditorScope}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" IsVisible="{Binding IsMechanicTimer}" Margin="16,0,0,0">
                        <CheckBox Content="Story" IsChecked="{Binding ActiveForStory}" ToolTip.Tip="Active in Story mode"/>
                        <CheckBox Content="Veteran" IsChecked="{Binding ActiveForVeteran}" ToolTip.Tip="Active in Veteran mode"/>
                        <CheckBox Content="Master" IsChecked="{Binding ActiveForMaster}" ToolTip.Tip="Active in Master mode"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="20,16" ColumnDefinitions="*,24,*">
                <StackPanel Spacing="12">
                    <TextBlock Classes="SectionHeading" Text="Starts when" Margin="0"/>
                    <ComboBox ItemsSource="{Binding AvailableTriggerTypes}" SelectedItem="{Binding SelectedTriggerType}"
                              HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDisplayNameConverter}, Mode=OneWay}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                    <StackPanel Spacing="5" IsVisible="{Binding ShowAbilityOption}">
                        <TextBlock Classes="FieldLabel" Text="Ability"/>
                        <TextBox x:Name="AbilityName" Text="{Binding Ability, UpdateSourceTrigger=PropertyChanged}" ToolTip.Tip="{Binding TriggerValueHelpText}"/>
                    </StackPanel>
                    <StackPanel Spacing="5" IsVisible="{Binding ShowEffectOption}">
                        <TextBlock Classes="FieldLabel" Text="Effect"/>
                        <TextBox x:Name="EffectName" Text="{Binding Effect, UpdateSourceTrigger=PropertyChanged}" ToolTip.Tip="{Binding TriggerValueHelpText}"/>
                    </StackPanel>
                    <Grid IsVisible="{Binding ShowHPOption}" ColumnDefinitions="*,12,*" RowDefinitions="Auto,Auto">
                        <TextBlock Classes="FieldLabel" Text="{Binding HPTriggerText, StringFormat='{}{0} (%)'}"/>
                        <TextBlock Grid.Column="2" Classes="FieldLabel" Text="Upper bound (%)"/>
                        <TextBox Grid.Row="1" x:Name="HPValue" Text="{Binding HPPercentage}" Margin="0,5,0,0" ToolTip.Tip="Health percentage"/>
                        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding HPPercentageUpper}" Margin="0,5,0,0"/>
                    </Grid>
                    <StackPanel Spacing="5" IsVisible="{Binding ShowCombatDurationOption}">
                        <TextBlock Classes="FieldLabel" Text="Elapsed combat time (seconds)"/>
                        <TextBox x:Name="CombatDurationValue" Text="{Binding CombatDuration}"/>
                    </StackPanel>
                    <StackPanel Spacing="5" IsVisible="{Binding ShowExternalTriggerOption}">
                        <TextBlock Classes="FieldLabel" Text="Timer"/>
                        <ComboBox ItemsSource="{Binding AvailableTimerNames}" SelectedItem="{Binding SelectedExternalTimerName}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding MultiClauseTrigger}">
                        <Button Classes="RoundedCorner DialogAction" Content="Condition A" Command="{Binding AddOrEditACommand}"/>
                        <Button Classes="RoundedCorner DialogAction" Content="Condition B" Command="{Binding AddOrEditBCommand}"/>
                    </StackPanel>
                    <StackPanel Spacing="5" IsVisible="{Binding HasSource}">
                        <TextBlock Classes="FieldLabel" Text="{Binding SourceText}"/>
                        <ComboBox ItemsSource="{Binding AvailableSources}" SelectedItem="{Binding SelectedSource}" HorizontalAlignment="Stretch"/>
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasCustomSource}">
                            <TextBox KeyDown="SourceEntered" Text="{Binding CustomSource, UpdateSourceTrigger=PropertyChanged}" ToolTip.Tip="Entity name or ID"/>
                            <Button Grid.Column="1" Margin="8,0,0,0" Classes="RoundedCorner DialogAction" Command="{Binding SaveSourceCommand}" Content="Add"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Spacing="5" IsVisible="{Binding HasTarget}">
                        <TextBlock Classes="FieldLabel" Text="{Binding TargetText}"/>
                        <ComboBox ItemsSource="{Binding AvailableTargets}" SelectedItem="{Binding SelectedTarget}" HorizontalAlignment="Stretch"/>
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasCustomTarget}">
                            <TextBox KeyDown="TargetEntered" Text="{Binding CustomTarget, UpdateSourceTrigger=PropertyChanged}" ToolTip.Tip="Entity name or ID"/>
                            <Button Grid.Column="1" Margin="8,0,0,0" Classes="RoundedCorner DialogAction" Command="{Binding SaveTargetCommand}" Content="Add"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Spacing="5" IsVisible="{Binding ShowAbsorbOption}">
                        <TextBlock Classes="FieldLabel" Text="Absorb amount"/>
                        <TextBox Text="{Binding AbsorbValue}"/>
                    </StackPanel>
                    <StackPanel Spacing="5" IsVisible="{Binding IsCheckingVariable}">
                        <TextBlock Classes="FieldLabel" Text="Variable"/>
                        <ComboBox ItemsSource="{Binding AvailableVariables}" SelectedItem="{Binding SelectedVariable}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <StackPanel Spacing="10" IsVisible="{Binding ShowStackVariableOptions}">
                        <CheckBox Content="Store value in a variable" IsChecked="{Binding SetVariableWithCharge}"
                                  ToolTip.Tip="Store the value instead of checking a comparison."/>
                        <StackPanel Spacing="5" IsVisible="{Binding SetVariableWithCharge}">
                            <TextBlock Classes="FieldLabel" Text="Variable"/>
                            <ComboBox ItemsSource="{Binding AvailableVariables}" SelectedItem="{Binding ChargeVariable}" HorizontalAlignment="Stretch"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Text="{Binding AddedVariable}" ToolTip.Tip="New variable name"/>
                                <Button Grid.Column="1" Margin="8,0,0,0" Classes="RoundedCorner DialogAction" Content="Add" Command="{Binding AddCustomVariableCommand}"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Spacing="5" IsVisible="{Binding SetVariableWithCharge, Converter={StaticResource BooleanToInverseConverter}}">
                            <TextBlock Classes="FieldLabel" Text="Comparison"/>
                            <ComboBox ItemsSource="{Binding AvailableComparisons}" SelectedItem="{Binding SelectedComparison}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDisplayNameConverter}, Mode=OneWay}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                            <TextBox IsVisible="{Binding IsCheckingSingleValue}" Text="{Binding VariableComparisonVal, UpdateSourceTrigger=PropertyChanged}" ToolTip.Tip="Comparison value"/>
                            <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,Auto" IsVisible="{Binding IsCheckingSingleValue, Converter={StaticResource BooleanToInverseConverter}}">
                                <TextBlock Classes="FieldLabel" Text="Minimum"/>
                                <TextBlock Grid.Column="2" Classes="FieldLabel" Text="Maximum"/>
                                <TextBox Grid.Row="1" Margin="0,5,0,0" Text="{Binding VariableMinVal, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Grid.Row="1" Grid.Column="2" Margin="0,5,0,0" Text="{Binding VariableMaxVal, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                    <Expander x:Name="BehaviorOptions" Header="Refresh &amp; cancellation" Classes="EditorAdvanced" Margin="0,8,0,0">
                        <StackPanel Spacing="10" Margin="0,10,0,0">
                    <CheckBox IsVisible="{Binding CanChangeCombatTracking}" Content="Track outside combat" IsChecked="{Binding TrackOutsideOfCombat}"/>
                    <StackPanel Spacing="5">
                        <TextBlock Classes="FieldLabel" Text="Cancel when timer triggers"/>
                        <ComboBox ItemsSource="{Binding AvailableTimerNames}" SelectedItem="{Binding SelectedCancelTimer}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <CheckBox Content="Ignore triggers while active" IsChecked="{Binding DontRefresh}"
                              ToolTip.Tip="Keep the current countdown when this trigger occurs again."/>
                    <StackPanel Spacing="8" IsVisible="{Binding ShowEffectRefreshOption}">
                        <CheckBox Content="Cancel when effect ends" IsChecked="{Binding ResetOnEffectLoss}"/>
                        <CheckBox Content="Additional refresh triggers" IsChecked="{Binding CanBeRefreshed}"
                                  ToolTip.Tip="Refresh this timer when an ability or effect in the list occurs."/>
                        <StackPanel Spacing="6" IsVisible="{Binding CanBeRefreshed}">
                            <ListBox MaxHeight="130" MinHeight="50" ItemsSource="{Binding AvailableRefreshOptions}" Background="{StaticResource Gray2Brush}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,Auto" Margin="2">
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="1" Classes="RoundedCorner" Content="Remove" Command="{Binding RemoveCommand}" Padding="6,3" FontSize="11"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Text="{Binding CustomRefreshOption, UpdateSourceTrigger=PropertyChanged}" ToolTip.Tip="Ability or effect name or ID">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding SaveRefreshOptionCommand}"/>
                                    </TextBox.KeyBindings>
                                </TextBox>
                                <Button Grid.Column="1" Margin="8,0,0,0" Classes="RoundedCorner DialogAction" Command="{Binding SaveRefreshOptionCommand}" Content="Add"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                        </StackPanel>
                    </Expander>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="12">
                    <TabStrip x:Name="EffectsTabStrip" SelectedIndex="0" SelectionChanged="EffectsTabStrip_OnSelectionChanged"
                              IsVisible="{Binding SetVariableWithCharge, Converter={StaticResource BooleanToInverseConverter}}">
                        <TabStripItem IsVisible="{Binding IncludeTimerVisuals}" Padding="0,2,12,6"><TextBlock Text="Display &amp; sound" FontSize="13" FontWeight="SemiBold"/></TabStripItem>
                        <TabStripItem IsVisible="{Binding IsModifyingVariables}" Padding="12,2,0,6"><TextBlock Text="Variables" FontSize="13" FontWeight="SemiBold"/></TabStripItem>
                    </TabStrip>
                    <ContentControl x:Name="TabContent" IsVisible="{Binding SetVariableWithCharge, Converter={StaticResource BooleanToInverseConverter}}"/>
                    <CheckBox x:Name="VariableCheck" Content="Modify variables" IsChecked="{Binding IsModifyingVariables}" Margin="0,8,0,0"
                              IsVisible="{Binding SetVariableWithCharge, Converter={StaticResource BooleanToInverseConverter}}"
                              ToolTip.Tip="Update a counter or value when this timer triggers."/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
        <Border Grid.Row="2" Classes="EditorFooter">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Text="{Binding ValidationMessage}" Foreground="{StaticResource RedColorBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button x:Name="CancelButton" Grid.Column="1" Classes="RoundedCorner DialogAction" Content="Cancel" MinWidth="80"/>
                <Button x:Name="SaveButton" Grid.Column="2" Classes="RoundedCorner DialogAction PrimaryAction" Content="Save" Command="{Binding SaveCommand}" MinWidth="80" Margin="8,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
