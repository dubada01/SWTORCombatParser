<UserControl x:Class="SWTORCombatParser.Views.Timers.HPTimerInstanceView"
             xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SWTORCombatParser.ViewModels.Timers" x:DataType="vm:TimerInstanceViewModel">
    <Border Classes="TimerTrack" Margin="0,2" IsVisible="{Binding DisplayTimer}">
        <Grid ColumnDefinitions="3,*,Auto">
            <Border Grid.ColumnSpan="3" Background="{Binding TimerForeground}" Opacity="0.42" RenderTransformOrigin="1,0">
                <Border.RenderTransform><ScaleTransform ScaleX="{Binding CurrentRatio}" ScaleY="1"/></Border.RenderTransform>
            </Border>
            <Border Classes="TimerAccent"/>
            <TextBlock Classes="TimerLabel" Grid.Column="1" Margin="7,0,6,0" FontFamily="{StaticResource MainFont}" FontSize="{Binding LabelFontSize}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="#EFF4F0" Text="{Binding HealthTimerLabel}"/>
            <TextBlock Grid.Column="2" Margin="7,0" FontFamily="{StaticResource MainFont}" FontSize="{Binding ValueFontSize}"
                       FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{Binding TimerBackground}"
                       IsVisible="{Binding ShowOverlayTimerValue}" Text="{Binding HealthTimerValue}"/>
        </Grid>
    </Border>
</UserControl>
