<Window x:Class="SWTORCombatParser.Views.MetricColorPickerWindow"
        xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.ColorPicker"
        xmlns:vm="clr-namespace:SWTORCombatParser.ViewModels" x:DataType="vm:MetricColorPickerViewModel"
        Classes="OrbsDialog" Title="Metric color" Width="420" Height="510" MinWidth="380" MinHeight="440"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,*,Auto" Margin="16">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBlock Text="{Binding OverlayType, Converter={StaticResource OverlayTypeToReadableNameConverter}}" Classes="SectionHeading" VerticalAlignment="Center" Margin="0"/>
            <Border Grid.Column="1" Background="{Binding MetricBrush}" CornerRadius="4" Width="44" Height="24"/>
        </Grid>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <controls:ColorView Color="{Binding MetricColor, Mode=TwoWay}" IsColorPaletteVisible="False" IsColorModelVisible="False"/>
        </ScrollViewer>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
            <Button Content="Restore default" Command="{Binding SetDefaultCommand}" Classes="RoundedCorner DialogAction" HorizontalAlignment="Left"/>
            <Button Grid.Column="1" Content="Done" Command="{Binding CloseCommand}" IsCancel="True" Classes="RoundedCorner PrimaryAction" MinWidth="86"/>
        </Grid>
    </Grid>
</Window>
