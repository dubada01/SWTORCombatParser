<UserControl x:Class="SWTORCombatParser.Views.Battle_Review.EventHistoryView"
 xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="clr-namespace:SWTORCombatParser.ViewModels.BattleReview" xmlns:data="clr-namespace:SWTORCombatParser.DataStructures" x:DataType="vm:EventHistoryViewModel">
 <UserControl.Styles>
  <Style Selector="DataGridColumnHeader"><Setter Property="Background" Value="{StaticResource Gray2Brush}"/><Setter Property="Foreground" Value="{StaticResource Gray12Brush}"/><Setter Property="FontSize" Value="11"/><Setter Property="Padding" Value="10,7"/></Style>
  <Style Selector="DataGridRow"><Setter Property="Background" Value="{StaticResource Gray1Brush}"/></Style>
  <Style Selector="DataGridRow:nth-child(even)"><Setter Property="Background" Value="#202224"/></Style>
  <Style Selector="DataGridRow:selected"><Setter Property="Background" Value="#263E35"/></Style>
  <Style Selector="DataGridCell"><Setter Property="Padding" Value="8,0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="WhiteSmoke"/></Style>
  <Style Selector="DataGridCell TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
 </UserControl.Styles>
 <Border BorderBrush="{StaticResource Gray4Brush}" BorderThickness="1" CornerRadius="3">
  <Grid>
   <DataGrid x:Name="DataArea" ItemsSource="{Binding LogsToDisplay}" SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
    SelectionChanged="Selection1List_SelectionChanged" LoadingRow="LoadRow" PointerEntered="DataArea_MouseEnter" PointerExited="DataArea_MouseLeave" PointerPressed="SelectContextRow"
    GotFocus="DataArea_GotFocus" LostFocus="DataArea_LostFocus" RowHeight="30" ColumnHeaderHeight="34" HeadersVisibility="Column"
    IsReadOnly="True" CanUserSortColumns="False" CanUserResizeColumns="True" SelectionMode="Single" GridLinesVisibility="None" AutoGenerateColumns="False"
    Background="{StaticResource Gray1Brush}" BorderThickness="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
    <DataGrid.ContextMenu><ContextMenu>
     <MenuItem Header="Copy source ID" Command="{Binding SelectedEntry.CellClickedCommand}" CommandParameter="Source" IsEnabled="{Binding HasSelection}"/>
     <MenuItem Header="Copy target ID" Command="{Binding SelectedEntry.CellClickedCommand}" CommandParameter="Target" IsEnabled="{Binding HasSelection}"/>
     <MenuItem Header="Copy ability ID" Command="{Binding SelectedEntry.CellClickedCommand}" CommandParameter="Ability" IsEnabled="{Binding HasSelection}"/>
     <MenuItem Header="Copy effect ID" Command="{Binding SelectedEntry.CellClickedCommand}" CommandParameter="Effect" IsEnabled="{Binding HasSelection}"/>
     <Separator/>
     <MenuItem Header="Ability on Jedipedia" Command="{Binding SelectedEntry.OpenJedipediaCommand}" CommandParameter="Ability" IsEnabled="{Binding SelectedEntry.CanLookupAbility}"/>
     <MenuItem Header="Effect on Jedipedia" Command="{Binding SelectedEntry.OpenJedipediaCommand}" CommandParameter="Effect" IsEnabled="{Binding SelectedEntry.CanLookupEffect}" ToolTip.Tip="Opens the effect's owning ability and its effect details"/>
     <Separator/>
     <MenuItem Header="Open log" Command="{Binding SelectedEntry.OpenLogCommand}" IsEnabled="{Binding SelectedEntry.CanOpenLog}"/>
    </ContextMenu></DataGrid.ContextMenu>
    <DataGrid.Columns>
     <DataGridTemplateColumn Header="Time" Width="92" MinWidth="86"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="data:DisplayableLogEntry">
      <TextBlock Text="{Binding SecondsSinceCombatStart}" FontFamily="Consolas" Foreground="{StaticResource Gray12Brush}" ToolTip.Tip="{Binding TimeDetail}"/>
     </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="Source" Width="1.1*" MinWidth="90"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="data:DisplayableLogEntry">
      <TextBlock Text="{Binding Source}" ToolTip.Tip="{Binding SourceDetail}"/>
     </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="Target" Width="1.1*" MinWidth="90"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="data:DisplayableLogEntry">
      <TextBlock Text="{Binding Target}" ToolTip.Tip="{Binding TargetDetail}"/>
     </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="Ability" Width="1.6*" MinWidth="125"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="data:DisplayableLogEntry">
      <Grid ColumnDefinitions="20,*" ToolTip.Tip="{Binding AbilityDetail}"><Image Source="{Binding AbilityIcon}" Width="16" Height="16"/><TextBlock Grid.Column="1" Text="{Binding Ability}"/></Grid>
     </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="Effect" Width="1.3*" MinWidth="95"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="data:DisplayableLogEntry">
      <Grid ColumnDefinitions="3,*" ToolTip.Tip="{Binding EffectDetail}"><Border Background="{Binding EventColor}" Height="14" CornerRadius="1"/><TextBlock Grid.Column="1" Margin="7,0,0,0" Text="{Binding EffectLabel}"/></Grid>
     </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="Result" Width="88" MinWidth="80"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="data:DisplayableLogEntry">
      <TextBlock Text="{Binding Result}" Foreground="{Binding EventColor}" ToolTip.Tip="{Binding EffectDetail}"/>
     </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="Amount" Width="90" MinWidth="80"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="data:DisplayableLogEntry">
      <TextBlock Text="{Binding Amount}" Margin="0,0,8,0" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{Binding EventColor}" ToolTip.Tip="{Binding AmountDetail}"/>
     </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    </DataGrid.Columns>
   </DataGrid>
   <TextBlock IsVisible="{Binding IsEmpty}" Text="{Binding EmptyMessage}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Gray12Brush}" IsHitTestVisible="False"/>
  </Grid>
 </Border>
</UserControl>
