<Window x:Class="SWTORCombatParser.Views.Phases.PhaseListView"
        xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SWTORCombatParser.ViewModels.Phases"
        x:DataType="vm:PhaseListViewModel" Classes="OrbsDialog"
        Title="Phases" Width="680" Height="500" MinWidth="600" MinHeight="350" WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,*,Auto" Margin="16">
        <ContentPresenter Content="{Binding EncounterSelectionView}" HorizontalAlignment="Left" Margin="-5,-5,0,12"/>
        <DataGrid Grid.Row="1" ItemsSource="{Binding PhaseRows}" IsReadOnly="True" AutoGenerateColumns="False"
                  GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="{StaticResource Gray4Brush}" RowHeight="38" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Width="*" Header="Name" Binding="{Binding Name}"/>
                <DataGridTextColumn Width="170" Header="Start condition" Binding="{Binding Type, Converter={StaticResource EnumDisplayNameConverter}, Mode=OneWay}"/>
                <DataGridTemplateColumn Width="64" Header="">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <Button Content="Edit" Command="{Binding EditCommand}" Classes="RoundedCorner" HorizontalAlignment="Center" Padding="8,3" ToolTip.Tip="Edit phase"/>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="74" Header="">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <Button Content="Delete" Command="{Binding DeleteCommand}" Classes="RoundedCorner DangerAction" HorizontalAlignment="Center" Padding="8,3" ToolTip.Tip="Delete phase"/>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Add phase" Command="{Binding AddPhaseCommand}" Classes="RoundedCorner DialogAction PrimaryAction"/>
        </StackPanel>
    </Grid>
</Window>
