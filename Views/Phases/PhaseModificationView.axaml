<Window x:Class="SWTORCombatParser.Views.Phases.PhaseModificationView"
        xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SWTORCombatParser.ViewModels.Phases"
        x:DataType="vm:PhaseModificationViewModel" Classes="OrbsDialog"
        Title="{Binding EditorTitle}" Width="780" Height="560" MinWidth="650" MinHeight="430" WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Classes="EditorHeader">
            <StackPanel Spacing="8">
                <TextBox x:Name="TimerName" Text="{Binding Name}" Watermark="Phase name" ToolTip.Tip="Name shown in the phase bar and challenge phase selector"/>
                <Grid ColumnDefinitions="Auto,Auto,*">
                    <TextBlock Classes="EditorContext" Text="{Binding SelectedEncounter}"/>
                    <TextBlock Grid.Column="1" Classes="EditorContext" Text=" / " Margin="6,0"/>
                    <TextBlock Grid.Column="2" Classes="EditorContext" Text="{Binding SelectedBoss}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SelectedBoss}"/>
                </Grid>
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,16" Spacing="16">
                <Grid ColumnDefinitions="*,24,*">
                <StackPanel Grid.Column="0" Spacing="10">
                    <TextBlock Classes="SectionHeading" Text="Starts when" Margin="0"/>
                    <ComboBox ItemsSource="{Binding AvailablePhaseTypes}" SelectedItem="{Binding SelectedPhaseStart}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDisplayNameConverter}, ConverterParameter=PhaseStart, Mode=OneWay}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                    <StackPanel Spacing="5" IsVisible="{Binding HasValue}">
                        <TextBlock Classes="FieldLabel" Text="{Binding ValuePrompt}" TextWrapping="Wrap"/>
                        <TextBox Text="{Binding Value}" ToolTip.Tip="Enter a percentage or duration in seconds, depending on the condition."/>
                    </StackPanel>
                    <StackPanel Spacing="5" IsVisible="{Binding HasTarget}">
                        <TextBlock Classes="FieldLabel" Text="{Binding TargetText}"/>
                        <TextBox Text="{Binding SelectedTarget, UpdateSourceTrigger=PropertyChanged}" ToolTip.Tip="Entity ID from the combat log."/>
                    </StackPanel>
                    <StackPanel Spacing="6" IsVisible="{Binding HasMultiValue}">
                        <TextBlock Classes="FieldLabel" Text="{Binding ValuePrompt}"/>
                        <ListBox ItemsSource="{Binding MultiValueOptions}" MinHeight="36" MaxHeight="104" Background="{StaticResource Gray1Brush}" BorderBrush="{StaticResource Gray4Brush}" BorderThickness="1"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" Margin="2">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/>
                                        <Button Grid.Column="1" Content="×" Command="{Binding RemoveCommand}" Classes="RoundedCorner" Padding="5,0" MinHeight="24"
                                                ToolTip.Tip="Remove this value"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox x:Name="StartValueDraft" Text="{Binding MultiValueOption, UpdateSourceTrigger=PropertyChanged}" Watermark="Name or ID"
                                     KeyDown="AddDraftOnEnter" Tag="{Binding SaveRefreshOptionCommand}"/>
                            <Button Grid.Column="1" Content="Add" Command="{Binding SaveRefreshOptionCommand}" Classes="RoundedCorner DialogAction" Margin="6,0,0,0"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Spacing="6" IsVisible="{Binding HasMultiTarget}">
                        <TextBlock Classes="FieldLabel" Text="{Binding TargetText}"/>
                        <ListBox ItemsSource="{Binding MultiTargetOptions}" MinHeight="36" MaxHeight="104" Background="{StaticResource Gray1Brush}" BorderBrush="{StaticResource Gray4Brush}" BorderThickness="1"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" Margin="2">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/>
                                        <Button Grid.Column="1" Content="×" Command="{Binding RemoveCommand}" Classes="RoundedCorner" Padding="5,0" MinHeight="24"
                                                ToolTip.Tip="Remove this entity"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox x:Name="StartTargetDraft" Text="{Binding MultiTargetOption, UpdateSourceTrigger=PropertyChanged}" Watermark="Entity ID"
                                     KeyDown="AddDraftOnEnter" Tag="{Binding SaveMultiTargetOption}"/>
                            <Button Grid.Column="1" Content="Add" Command="{Binding SaveMultiTargetOption}" Classes="RoundedCorner DialogAction" Margin="6,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
                    <Border Grid.Column="1" Width="1" Background="{StaticResource Gray4Brush}" Margin="0,0,0,2"/>
                <StackPanel Grid.Column="2" Spacing="10">
                    <TextBlock Classes="SectionHeading" Text="Ends when" Margin="0"/>
                    <ComboBox ItemsSource="{Binding AvailablePhaseTypes}" SelectedItem="{Binding SelectedPhaseEnd}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDisplayNameConverter}, ConverterParameter=PhaseEnd, Mode=OneWay}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                    <StackPanel Spacing="5" IsVisible="{Binding EndHasValue}">
                        <TextBlock Classes="FieldLabel" Text="{Binding EndValuePrompt}" TextWrapping="Wrap"/>
                        <TextBox Text="{Binding EndValue}" ToolTip.Tip="Enter a percentage or duration in seconds, depending on the condition."/>
                    </StackPanel>
                    <StackPanel Spacing="5" IsVisible="{Binding EndHasTarget}">
                        <TextBlock Classes="FieldLabel" Text="{Binding EndTargetText}"/>
                        <TextBox Text="{Binding EndSelectedTarget, UpdateSourceTrigger=PropertyChanged}" ToolTip.Tip="Entity ID from the combat log."/>
                    </StackPanel>
                    <StackPanel Spacing="6" IsVisible="{Binding EndHasMultiValue}">
                        <TextBlock Classes="FieldLabel" Text="{Binding EndValuePrompt}"/>
                        <ListBox ItemsSource="{Binding EndMultiValueOptions}" MinHeight="36" MaxHeight="104" Background="{StaticResource Gray1Brush}" BorderBrush="{StaticResource Gray4Brush}" BorderThickness="1"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" Margin="2">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/>
                                        <Button Grid.Column="1" Content="×" Command="{Binding RemoveCommand}" Classes="RoundedCorner" Padding="5,0" MinHeight="24"
                                                ToolTip.Tip="Remove this value"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox x:Name="EndValueDraft" Text="{Binding EndMultiValueOption, UpdateSourceTrigger=PropertyChanged}" Watermark="Name or ID"
                                     KeyDown="AddDraftOnEnter" Tag="{Binding EndSaveRefreshOptionCommand}"/>
                            <Button Grid.Column="1" Content="Add" Command="{Binding EndSaveRefreshOptionCommand}" Classes="RoundedCorner DialogAction" Margin="6,0,0,0"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Spacing="6" IsVisible="{Binding EndHasMultiTarget}">
                        <TextBlock Classes="FieldLabel" Text="{Binding EndTargetText}"/>
                        <ListBox ItemsSource="{Binding EndMultiTargetOptions}" MinHeight="36" MaxHeight="104" Background="{StaticResource Gray1Brush}" BorderBrush="{StaticResource Gray4Brush}" BorderThickness="1"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" Margin="2">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/>
                                        <Button Grid.Column="1" Content="×" Command="{Binding RemoveCommand}" Classes="RoundedCorner" Padding="5,0" MinHeight="24"
                                                ToolTip.Tip="Remove this entity"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox x:Name="EndTargetDraft" Text="{Binding EndMultiTargetOption, UpdateSourceTrigger=PropertyChanged}" Watermark="Entity ID"
                                     KeyDown="AddDraftOnEnter" Tag="{Binding EndSaveMultiTargetOption}"/>
                            <Button Grid.Column="1" Content="Add" Command="{Binding EndSaveMultiTargetOption}" Classes="RoundedCorner DialogAction" Margin="6,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Classes="EditorFooter">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Text="{Binding ValidationMessage}" Foreground="{StaticResource RedColorBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Grid.Column="1" x:Name="CancelButton" Content="Cancel" IsCancel="True" Classes="RoundedCorner DialogAction" MinWidth="82"/>
                <Button Grid.Column="2" Content="Save phase" IsDefault="True" Command="{Binding SaveCommand}" Classes="RoundedCorner DialogAction PrimaryAction" MinWidth="100" Margin="8,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
