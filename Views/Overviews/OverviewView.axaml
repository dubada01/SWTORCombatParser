<UserControl x:Class="SWTORCombatParser.Views.Overviews.OverviewView" Classes="AnalysisPage"
 xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="clr-namespace:SWTORCombatParser.ViewModels.Overviews" xmlns:c="clr-namespace:SWTORCombatParser.Utilities.Converters" x:DataType="vm:TableViewModel">
 <UserControl.Resources><c:EnumDisplayNameConverter x:Key="GroupName"/></UserControl.Resources>
 <UserControl.Styles><StyleInclude Source="avares://Orbs/Utilities/UIStyles/Analysis.axaml"/></UserControl.Styles>
 <Grid RowDefinitions="Auto,Auto,*" Margin="12,10" RowSpacing="10">
  <Grid ColumnDefinitions="Auto,220,Auto,140,*" ColumnSpacing="8">
   <TextBlock Classes="AnalysisLabel" Text="Participant"/>
   <ComboBox x:Name="DetailsParticipant" Grid.Column="1" ItemsSource="{Binding AvailableParticipants}" SelectedItem="{Binding SelectedEntity}" HorizontalAlignment="Stretch" FontSize="12">
    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
   </ComboBox>
   <TextBlock Grid.Column="2" Classes="AnalysisLabel" Text="Group by" Margin="8,0,0,0"/>
   <ComboBox x:Name="DetailsGrouping" Grid.Column="3" ItemsSource="{Binding AvailableOrderings}" SelectedItem="{Binding SelectedOrdering}" HorizontalAlignment="Stretch" FontSize="12">
    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding ., Converter={StaticResource GroupName}, Mode=OneWay}"/></DataTemplate></ComboBox.ItemTemplate>
   </ComboBox>
   <TextBox x:Name="DetailsSearch" Grid.Column="4" Text="{Binding ActiveTable.FilterText}" Watermark="Find in results…" MinWidth="100"/>
  </Grid>
  <TabStrip x:Name="DetailsTabs" Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Height="36">
   <TabStrip.Styles><Style Selector="TabStripItem"><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="12,6"/></Style></TabStrip.Styles>
   <TabStripItem Content="Damage"/><TabStripItem Content="Healing"/><TabStripItem Content="Damage taken"/><TabStripItem Content="Healing received"/><TabStripItem Content="Threat"/>
  </TabStrip>
  <ContentPresenter Grid.Row="2" Content="{Binding SelectedDataTypeContent}"/>
 </Grid>
</UserControl>
