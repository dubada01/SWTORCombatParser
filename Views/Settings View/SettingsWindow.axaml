<Window x:Class="SWTORCombatParser.Views.SettingsView.SettingsWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Classes="OrbsDialog" Title="Settings" Width="580" Height="620"
        MinWidth="500" MinHeight="420" WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="*,Auto">
        <TabControl Margin="16,12,16,0">
            <TabItem Header="General">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,14,8,16" Spacing="8">
                        <TextBlock Classes="SectionHeading" Text="Combat logs"/>
                        <TextBlock Classes="FieldLabel" Text="Log folder"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Name="LogPath" IsReadOnly="True" ToolTip.Tip="The folder where SWTOR writes its combat logs."/>
                            <Button Grid.Column="1" Name="SetCombatLogsPath" Content="Browse…" Classes="DialogAction" Margin="8,0,0,0"/>
                        </Grid>
                        <CheckBox Name="ForceLogUpdates" Content="Poll for log changes"
                                  ToolTip.Tip="Check for new log data without waiting for operating-system notifications. May increase CPU use."/>
                        <Border Classes="SectionDivider"/>
                        <TextBlock Classes="SectionHeading" Text="Hotkeys"/>
                        <Grid ColumnDefinitions="Auto,*,170" RowDefinitions="Auto,Auto,Auto">
                            <CheckBox Grid.Row="0" Name="LockEnabled" Margin="0,0,12,8" ToolTip.Tip="Enable the overlay lock hotkey."/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Classes="FieldLabel" Text="Lock / unlock overlays" Margin="0,0,12,8"/>
                            <TextBox Grid.Row="0" Grid.Column="2" Name="LockHotkey" Tag="Lock" Margin="0,0,0,8" IsReadOnly="True"
                                     HorizontalContentAlignment="Center" KeyDown="TextBox_PreviewKeyDown" ToolTip.Tip="Focus this field and press a key combination."/>
                            <CheckBox Grid.Row="1" Name="RefreshEnabled" Margin="0,0,12,8" ToolTip.Tip="Enable the raid-name detection hotkey."/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Classes="FieldLabel" Text="Detect raid names" Margin="0,0,12,8"/>
                            <TextBox Grid.Row="1" Grid.Column="2" Name="RefreshHotkey" Tag="Refresh" Margin="0,0,0,8" IsReadOnly="True"
                                     HorizontalContentAlignment="Center" KeyDown="TextBox_PreviewKeyDown" ToolTip.Tip="Focus this field and press a key combination."/>
                            <CheckBox Grid.Row="2" Name="HideEnabled" Margin="0,0,12,0" ToolTip.Tip="Enable the hide-overlays hotkey."/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Classes="FieldLabel" Text="Hide overlays" Margin="0,0,12,0"/>
                            <TextBox Grid.Row="2" Grid.Column="2" Name="HideHotkey" Tag="Hide" IsReadOnly="True"
                                     HorizontalContentAlignment="Center" KeyDown="TextBox_PreviewKeyDown" ToolTip.Tip="Focus this field and press a key combination."/>
                        </Grid>
                        <Border Classes="SectionDivider"/>
                        <TextBlock Classes="SectionHeading" Text="Application"/>
                        <CheckBox Name="OfflineMode" Content="Offline mode"
                                  ToolTip.Tip="Disable online services such as leaderboards and automatic name detection."/>
                        <CheckBox Name="RunInBackground" Content="Run in background"
                                  ToolTip.Tip="Keep Orbs in the system tray and show it when SWTOR launches."/>
                        <CheckBox Name="BackgroundWarning" Content="Show background reminder"
                                  ToolTip.Tip="Show a reminder when Orbs continues running in the background."/>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                            <TextBlock Classes="FieldLabel" Text="Startup messages"/>
                            <Button Grid.Column="1" Name="ResetMessagesButton" Content="View messages" Classes="DialogAction"
                                    ToolTip.Tip="View startup messages, including ones you have already dismissed."/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Overlay details">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,14,8,16" Spacing="8">
                        <TextBlock Classes="SectionHeading" Text="Desktop compatibility"/>
                        <TextBlock Name="OverlayPlatformGuidance" TextWrapping="Wrap"/>
                        <TextBlock Name="OverlayPlatformReport" TextWrapping="Wrap"/>
                        <TextBlock Text="After changing desktop settings, unlock and relock overlays to retry. The main window's overlay controls remain available if global hotkeys are blocked." TextWrapping="Wrap"/>
                        <Border Classes="SectionDivider"/>
                        <StackPanel Name="ObsCaptureSettings" IsVisible="False" Spacing="8">
                            <TextBlock Classes="SectionHeading" Text="OBS capture"/>
                            <CheckBox Name="ShowOverlaysInObs" Content="Show overlays in OBS"
                                      ToolTip.Tip="Add each visible overlay as a Window Capture source in OBS using Windows Graphics Capture."/>
                            <Border Classes="SectionDivider"/>
                        </StackPanel>
                        <TextBlock Classes="SectionHeading" Text="Raid frames"/>
                        <CheckBox Name="ShowTargeted" Content="Highlight the boss's target"
                                  ToolTip.Tip="Draw a blue outline around the raid frame of the player targeted by the boss."/>
                        <Border Classes="SectionDivider"/>
                        <TextBlock Classes="SectionHeading" Text="Boss frames"/>
                        <CheckBox Name="BossFrameDot" Content="Show personal damage-over-time effects"
                                  ToolTip.Tip="Display your active DOTs on the boss frame."/>
                        <CheckBox Name="BossFrameCurrentTarget" Content="Show the boss's current target"/>
                        <CheckBox Name="ShowCombatDuration" Content="Show combat duration"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <Border Grid.Row="1" BorderBrush="{StaticResource Gray4Brush}" BorderThickness="0,1,0,0" Padding="16,12">
            <Grid ColumnDefinitions="*,Auto">
                <Button Name="EmergencyUIReset" Content="Reset overlay positions…" Classes="DangerAction" HorizontalAlignment="Left"
                        ToolTip.Tip="Bring saved overlays back onto this display for all roles. Sizes, timers, colors, and other settings are kept."/>
                <Button Grid.Column="1" Content="Done" Click="Cancel" Classes="PrimaryAction" MinWidth="82" IsDefault="True"/>
            </Grid>
        </Border>
    </Grid>
</Window>
