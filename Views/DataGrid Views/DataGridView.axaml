<UserControl x:Class="SWTORCombatParser.Views.DataGrid_Views.DataGridView" Classes="AnalysisPage"
 xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="clr-namespace:SWTORCombatParser.ViewModels.DataGrid" x:DataType="vm:DataGridViewModel">
 <UserControl.Styles><StyleInclude Source="avares://Orbs/Utilities/UIStyles/Analysis.axaml"/></UserControl.Styles>
 <Grid RowDefinitions="Auto,*" RowSpacing="10" Margin="12,10">
  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
   <TextBlock Classes="AnalysisLabel" Text="{Binding CombatSummary}"/>
   <Button x:Name="MetricsButton" Grid.Column="1" Classes="AnalysisAction" Content="Metrics" IsEnabled="{Binding HasCombat}" ToolTip.Tip="Choose the metrics shown in this table.">
    <Button.Flyout><Flyout Placement="BottomEdgeAlignedRight">
     <StackPanel Width="390" Spacing="10">
      <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Table metrics" FontWeight="SemiBold" FontSize="14"/><TextBlock Grid.Column="1" Text="{Binding MetricCountLabel}" FontSize="11" VerticalAlignment="Center"/></Grid>
      <ScrollViewer MaxHeight="410" HorizontalScrollBarVisibility="Disabled">
       <ItemsControl ItemsSource="{Binding MetricGroups}">
        <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:MetricColumnGroup">
         <StackPanel Spacing="4" Margin="0,0,0,10">
          <TextBlock Text="{Binding Name}" Foreground="{StaticResource Gray12Brush}" FontSize="11"/>
          <ItemsControl ItemsSource="{Binding Metrics}">
           <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
           <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:MetricColumnOption">
            <CheckBox Classes="AnalysisMetric" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding IsEnabled}" FontSize="12" MinHeight="28">
             <TextBlock Text="{Binding Name}" Foreground="{StaticResource Gray12Brush}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/>
            </CheckBox>
           </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
         </StackPanel>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </ScrollViewer>
      <Button Classes="AnalysisAction" Content="Restore defaults" Command="{Binding ResetMetricsCommand}" HorizontalAlignment="Left"/>
     </StackPanel>
    </Flyout></Button.Flyout>
   </Button>
  </Grid>
  <Grid Grid.Row="1">
   <DataGrid Classes="AnalysisTable" Sorting="DynamicDataGrid_OnSorting" x:Name="DynamicDataGrid" IsReadOnly="True" AutoGenerateColumns="False" ItemsSource="{Binding PartyMembers}"/>
   <TextBlock Text="Select a combat to review" IsVisible="{Binding !HasCombat}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Gray12Brush}" IsHitTestVisible="False"/>
  </Grid>
 </Grid>
</UserControl>
