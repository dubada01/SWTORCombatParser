<UserControl x:Class="SWTORCombatParser.Views.Challenges.ChallengeWindowInstance"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SWTORCombatParser.Views.Challenges"
                xmlns:vm="clr-namespace:SWTORCombatParser.ViewModels.Challenges"
                x:DataType="vm:ChallengeInstanceViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>
        <Border Classes="OverlayCard" Padding="7,4" Margin="0,0,0,3">
            <StackPanel Spacing="3">
                <TextBlock FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding ChallengeName}" Foreground="#EFF4F0" FontFamily="{StaticResource MainFont}"/>
                <TextBlock Text="{Binding ResultLabel}" Classes="OverlayLabel OverlayDetail"/>
            </StackPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Hidden" x:Name="ScrollView" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding MetricBars, UpdateSourceTrigger=PropertyChanged}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid ToolTip.Tip="{Binding InfoText}" Margin="0,1" Height="{Binding BarHeight}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="{Binding ValueWidth}"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.ColumnSpan="2" Background="{DynamicResource OverlaySurfaceBrush}" CornerRadius="2"/>
                            <Grid Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" Opacity="0.55">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding BarWidth, Mode=TwoWay}"/>
                                    <ColumnDefinition Width="{Binding RemainderWidth, Mode=TwoWay}"/>
                                </Grid.ColumnDefinitions>
                                <Border BorderThickness="{Binding BorderThickness}" BorderBrush="{Binding BarOutline}" Margin="0,0,0,0" Grid.Column="0" CornerRadius="{Binding BarRadius}" Background="{Binding ChallengeColor}" ></Border>
                            </Grid>

                            <TextBlock Margin="0,0,7,0" Grid.Column="1" FontSize="{Binding FontSize}" FontWeight="SemiBold" FontFamily="{StaticResource MainFont}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#EFF4F0" Text="{Binding TotalValue}"/>

                            <Grid VerticalAlignment="Center" Margin="7,0,5,0">
                                <TextBlock FontFamily="{StaticResource MainFont}" FontSize="{Binding InfoFontSize}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="#EFF4F0" Text="{Binding PlayerName}"/>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Grid Grid.Row="2" Background="{DynamicResource OverlaySurfaceBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.33*"/>
                <ColumnDefinition Width="0.66*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Margin="7,0" Classes="OverlayLabel" VerticalAlignment="Center" Text="TOTAL"/>
            <TextBlock Margin="0,0,7,0" Grid.Column="1" FontFamily="{StaticResource MainFont}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#D8C599" Text="{Binding MetricTotal}"/>
        </Grid>
    </Grid>
</UserControl>
