<Window x:Class="SWTORCombatParser.Views.Challenges.ChallengeModificationView"
        xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SWTORCombatParser.ViewModels.Challenges"
        x:DataType="vm:ChallengeModificationViewModel" Classes="OrbsDialog"
        Title="{Binding EditorTitle}" Width="760" Height="480" MinWidth="660" MinHeight="430" WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Classes="EditorHeader">
            <StackPanel Spacing="8">
                <TextBox x:Name="TimerName" Text="{Binding Name}" Watermark="Challenge name" ToolTip.Tip="Name shown on the challenge overlay"/>
                <Grid ColumnDefinitions="Auto,Auto,*">
                    <TextBlock Classes="EditorContext" Text="{Binding SelectedEncounter}"/>
                    <TextBlock Grid.Column="1" Classes="EditorContext" Text=" / " Margin="6,0"/>
                    <TextBlock Grid.Column="2" Classes="EditorContext" Text="{Binding SelectedBoss}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SelectedBoss}"/>
                </Grid>
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid Margin="20,16" ColumnDefinitions="3*,32,2*">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="SectionHeading" Text="Measure" Margin="0"/>
                        <ComboBox x:Name="ChallengeType" ItemsSource="{Binding AvailableChallengeTypes}" SelectedItem="{Binding SelectedChallengeType}">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDisplayNameConverter}, ConverterParameter=Challenge, Mode=OneWay}"/></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Spacing="5" IsVisible="{Binding HasTarget}">
                        <TextBlock Classes="FieldLabel" Text="{Binding TargetText}"/>
                        <TextBox x:Name="ChallengeTarget" Text="{Binding SelectedTarget, UpdateSourceTrigger=PropertyChanged}" Watermark="Any target" ToolTip.Tip="Enemy name or ID from the combat log. Leave empty to include every target."/>
                    </StackPanel>
                    <StackPanel Spacing="5" IsVisible="{Binding HasSource}">
                        <TextBlock Classes="FieldLabel" Text="{Binding SourceText}"/>
                        <TextBox x:Name="ChallengeSource" Text="{Binding SelectedSource, UpdateSourceTrigger=PropertyChanged}" Watermark="Any attacker" ToolTip.Tip="Enemy name or ID from the combat log. Leave empty to include every attacker."/>
                    </StackPanel>
                    <StackPanel Spacing="5" IsVisible="{Binding HasValue}">
                        <TextBlock Classes="FieldLabel" Text="{Binding ValuePrompt}"/>
                        <TextBox x:Name="ChallengeValue" Text="{Binding Value}" Watermark="{Binding ValueWatermark}" ToolTip.Tip="{Binding ValueWatermark}"/>
                    </StackPanel>
                    <StackPanel Spacing="5" IsVisible="{Binding HasPhases}">
                        <TextBlock Classes="FieldLabel" Text="During phase"/>
                        <ComboBox x:Name="ChallengePhase" ItemsSource="{Binding AvailablePhases}" SelectedItem="{Binding SelectedPhase}" PlaceholderText="Select a phase" ToolTip.Tip="Phases configured for this encounter and boss.">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Width="1" Background="{StaticResource Gray4Brush}"/>
                <StackPanel Grid.Column="2" Spacing="12">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="SectionHeading" Text="Result" Margin="0"/>
                        <ComboBox x:Name="ResultMode" IsVisible="{Binding HasResultMode}" ItemsSource="{Binding ResultModes}" SelectedItem="{Binding SelectedResultMode, Mode=TwoWay}"/>
                        <TextBlock IsVisible="{Binding HasFixedResult}" Text="{Binding FixedResult}" Margin="0,7"/>
                        <ComboBox x:Name="PhaseMetric" IsVisible="{Binding HasPhases}" ItemsSource="{Binding AvailableMetrics}" SelectedItem="{Binding SelectedMetric}" ToolTip.Tip="Metric calculated using only the selected phase."/>
                    </StackPanel>
                    <Border Classes="SectionDivider" Margin="0,4"/>
                    <StackPanel Spacing="6">
                        <TextBlock Classes="FieldLabel" Text="Overlay color"/>
                        <Grid ColumnDefinitions="64,8,*">
                            <ColorPicker Width="64" Height="32" Color="{Binding SelectedColor, Mode=TwoWay}"/>
                            <TextBox Grid.Column="2" Text="{Binding CurrentColorHex, UpdateSourceTrigger=PropertyChanged}" ToolTip.Tip="Hex color, such as #6495ED"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
        <Border Grid.Row="2" Classes="EditorFooter">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Text="{Binding ValidationMessage}" Foreground="{StaticResource RedColorBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button Grid.Column="1" x:Name="CancelButton" Content="Cancel" IsCancel="True" Classes="RoundedCorner DialogAction" MinWidth="82"/>
                <Button Grid.Column="2" Content="Save challenge" IsDefault="True" Command="{Binding SaveCommand}" Classes="RoundedCorner DialogAction PrimaryAction" MinWidth="112" Margin="8,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
