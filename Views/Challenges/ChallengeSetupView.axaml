<Window x:Class="SWTORCombatParser.Views.Challenges.ChallengeSetupView"
        xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SWTORCombatParser.ViewModels.Challenges"
        x:DataType="vm:ChallengeSetupViewModel" Classes="OrbsDialog"
        Title="Challenges" Width="760" Height="540" MinWidth="680" MinHeight="380" WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,*,Auto" Margin="16">
        <ContentPresenter Content="{Binding EncounterSelectionView}" HorizontalAlignment="Left" Margin="-5,-5,0,12"/>
        <DataGrid Grid.Row="1" ItemsSource="{Binding ChallengeRows}" IsReadOnly="True" AutoGenerateColumns="False"
                  GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="{StaticResource Gray4Brush}" RowHeight="38" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="*" Header="Name">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <Grid ColumnDefinitions="8,*" Margin="8,0">
                            <Border Background="{Binding ChallengeBackground}" CornerRadius="2" Height="18"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/>
                        </Grid>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Width="145" Header="Type" Binding="{Binding Type, Converter={StaticResource EnumDisplayNameConverter}, Mode=OneWay}"/>
                <DataGridTemplateColumn Width="80" Header="Active">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <CheckBox IsChecked="{Binding IsEnabled}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="Enable this challenge"/>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="64" Header="">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <Button Content="Edit" Command="{Binding EditCommand}" Classes="RoundedCorner" HorizontalAlignment="Center" Padding="8,3" ToolTip.Tip="Edit challenge"/>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="64" Header="">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <Button Content="Share" Command="{Binding ShareCommand}" Classes="RoundedCorner" HorizontalAlignment="Center" Padding="8,3" ToolTip.Tip="Get a share code"/>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="74" Header="">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <Button Content="Delete" Command="{Binding DeleteCommand}" Classes="RoundedCorner DangerAction" HorizontalAlignment="Center" Padding="8,3" ToolTip.Tip="Delete challenge"/>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="2" ColumnDefinitions="Auto,150,Auto,*,Auto" Margin="0,12,0,0">
            <TextBlock Classes="FieldLabel" Text="Share code" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" Text="{Binding ImportId}" Watermark="Challenge code" ToolTip.Tip="Paste a shared challenge code."/>
            <Button Grid.Column="2" Content="Import" Command="{Binding ImportCommand}" Classes="RoundedCorner DialogAction" Margin="6,0,0,0"/>
            <Button Grid.Column="4" Content="Add challenge" Command="{Binding AllChallengeCommand}" Classes="RoundedCorner DialogAction PrimaryAction" Margin="16,0,0,0"/>
        </Grid>
    </Grid>
</Window>
